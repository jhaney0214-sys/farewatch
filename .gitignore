# Your own profile - home airports, budget, wishlist. Copy the example.
config/profile.json

# Last alerting run's routes, for change detection (fw.py run --alert).
data/alerts-state.json

# Cruises you are watching (fw.py watch). Names the trip you are planning.
data/watch.json

# What people pay to leave your base airport (tools/build_positioning.py).
# Names your home airport, so it stays with the profile.
data/positioning_fares.json

# The group trip site has its own local repo: it holds the link token, the deals
# key and the contact address, and this repo is public.
/site/
